# Copia este archivo como .env.production y reemplaza los marcadores.
# El .env.production NO se sube a Git. Cómo generar secretos: docs/despliegue.md.

# ───── Base de datos ─────
POSTGRES_USER=bestline_prod
# Solo letras y números (va dentro de la URL de conexión).
POSTGRES_PASSWORD=<secreto-hexadecimal-de-48-caracteres>
POSTGRES_DB=bestline_prod

# ───── Autenticación ─────
JWT_SECRET=<secreto-hexadecimal-de-96-caracteres>
JWT_EXPIRES_IN=8h

# ───── Administrador inicial ─────
# Se usa solo la primera vez, con la base vacía. Después, la contraseña se
# cambia desde la pantalla Usuarios. De 12 a 72 caracteres.
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=<correo-del-administrador>
ADMIN_PASSWORD=<contraseña-del-administrador>

# ───── Rutas sugeridas ─────
# Servidor público de demostración de OSRM (uso limitado, sin garantía).
# Para usar uno propio: http://<host>:5000
OSRM_URL=https://router.project-osrm.org

# ───── Swagger (/api/docs) ─────
# false: apagado. Enciéndelo solo para consultarlo o capturarlo (docs/despliegue.md).
SWAGGER_HABILITADO=false
