# Copia este archivo como .env y reemplaza los marcadores. El .env NO se sube a Git.

# Puerto de la API
PORT=3000

# Origen permitido por CORS (frontend de desarrollo con Vite)
CORS_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL. Usuario, contraseña y base deben coincidir con el .env de la raíz.
DATABASE_URL="postgresql://<usuario_bd>:<contraseña_bd>@localhost:5432/bestline?schema=public"

# Usuario ADMINISTRADOR que crea el seed (la contraseña se guarda cifrada con bcrypt).
ADMIN_NOMBRE="Administrador"
ADMIN_EMAIL=<correo_admin>
ADMIN_PASSWORD=<contraseña_admin>
