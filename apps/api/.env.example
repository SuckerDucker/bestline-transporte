# Copia este archivo como .env y reemplaza los marcadores. El .env NO se sube a Git.

# Puerto de la API
PORT=3000

# Origen permitido por CORS (frontend de desarrollo con Vite)
CORS_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL. Usuario, contraseña y base deben coincidir con el .env de la raíz.
DATABASE_URL="postgresql://<usuario_bd>:<contraseña_bd>@localhost:5432/bestline?schema=public"

# Usuario ADMINISTRADOR que crea el seed (la contraseña se guarda cifrada con bcrypt).
ADMIN_NOMBRE="Administrador"
ADMIN_EMAIL=<correo_admin>
ADMIN_PASSWORD=<contraseña_admin>

# JWT: secreto para firmar los tokens (cadena larga y aleatoria) y su duración.
JWT_SECRET=<secreto_jwt>
JWT_EXPIRES_IN=8h

# Contraseña de los usuarios de ejemplo del seed (COORDINADOR, SUPERVISOR y OPERADOR).
SEED_PASSWORD_EJEMPLO=<contraseña_usuarios_ejemplo>

# Base de datos para las pruebas e2e (se crea y migra sola al correr npm run test:e2e).
DATABASE_URL_TEST="postgresql://<usuario_bd>:<contraseña_bd>@localhost:5432/bestline_test?schema=public"
